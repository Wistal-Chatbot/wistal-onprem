ANTHROPIC_API_KEY="xxxxx"
# Model used for the chat orchestrator (text-to-SQL). Defaults to claude-sonnet-4-6.
ANTHROPIC_CHAT_MODEL="claude-sonnet-4-6"
# Optional. Admin API key for live monthly token-usage AND cost (USD spend)
# lookups. When empty, the monthly AI token limit is read but usage is treated as
# unavailable (does not block), and the admin „Zużycie AI / mies." tile shows „—".
ANTHROPIC_ADMIN_KEY=""
DATABASE_URL="xxxxx"
# Optional fallback used by Drizzle tooling and compatible with the Blumpo setup.
POSTGRES_URL="xxxxx"
JWT_SECRET="xxxxx"
RESEND_API_KEY="xxxxxx"
# Verified sender domain in Resend; change here to swap the OTP "from" address.
RESEND_FROM_EMAIL="no-reply@wistal-stal.pl"
BASE_URL="http://localhost:3000"
# Only @wistal.com.pl addresses can log in. To allow specific external
# addresses, list them here (comma-separated, exact match). Empty by default.
AUTH_ALLOWED_EXTERNAL_EMAILS=""
# BizRaport API (external Polish company data — KRS, financials, KRZ, Monitor Sądowy).
# When both are set, the chat gets the get_company_info / search_company tools.
# Sent as HTTP Basic Auth; calls are billed per returned row.
BIZRAPORT_API_EMAIL="xxxx"
BIZRAPORT_API_PASSWORD="xxxxx"
# Google Places API (New) — company Google rating only (score + rating count, no
# reviews). When set, the chat gets the get_google_rating tool; reports opt in via
# model_config.uses_google_rating. Uses Text Search with a minimal field mask.
GOOGLE_PLACES_API_KEY="xxxxx"